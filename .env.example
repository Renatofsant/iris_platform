# =============================================================================
# Plataforma Íris — variáveis de ambiente
# Copie para .env e preencha. O .env é carregado por app/__init__.py e passenger_wsgi.py.
# NUNCA versione o .env. scripts/verificar_predeploy.py confere se este arquivo documenta
# todas as variáveis usadas no código e se nenhum segredo real foi colado aqui.
# Legenda: [OBRIGATÓRIA EM PRODUÇÃO] · [opcional] (o padrão vem entre parênteses)
# =============================================================================

# --- Flask / segurança -------------------------------------------------------
# [OBRIGATÓRIA EM PRODUÇÃO] Assina sessões e tokens CSRF. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Sem ela, o app cria instance/secret_key (bom só para desenvolvimento).
IRIS_SECRET_KEY=""
# [OBRIGATÓRIA EM PRODUÇÃO] "1" = cookies só via HTTPS. passenger_wsgi.py já usa "1" por padrão.
IRIS_COOKIE_SEGURO="0"
# [opcional] "strong" (padrão) derruba a sessão se IP/navegador mudarem; "basic" é mais tolerante
# (útil em escolas com troca frequente de rede Wi-Fi/4G).
IRIS_PROTECAO_SESSAO="strong"
# [opcional] Se definido, o cadastro de professores exige este código de convite.
# IRIS_CODIGO_CONVITE=""
# [OBRIGATÓRIA EM PRODUÇÃO] Endereço público, usado nos links dos e-mails (confirmação e
# redefinição de senha). Cadastre também no Supabase: Authentication → URL Configuration.
IRIS_URL_PUBLICA="http://localhost:5000"

# --- Banco local (SQLite: alunos, materiais, métricas, eventos AEE) -----------
# [OBRIGATÓRIA EM PRODUÇÃO] Caminho FORA da pasta pública, ex.: /home/u123456789/iris-dados/iris.db
# (padrão: instance/iris.db)
# IRIS_DB_PATH="/home/u123456789/iris-dados/iris.db"
# [opcional] Dias até um material de impressão expirar (30).
IRIS_IMPRESSAO_RETENCAO_DIAS="30"

# --- Supabase (autenticação) — Project Settings → API ------------------------
# [OBRIGATÓRIA] Project URL exata: https://<ref de 20 caracteres>.supabase.co
SUPABASE_URL="https://<ref-do-projeto>.supabase.co"
# [OBRIGATÓRIA] Chave PUBLICÁVEL (sb_publishable_… ou a JWT "anon"). Nunca a secreta no app.
# Nomes alternativos aceitos: SUPABASE_PUBLISHABLE_KEY, SUPABASE_ANON_KEY.
SUPABASE_KEY="sb_publishable_..."
# [opcional] "supabase" (padrão quando URL e chave existem) ou "local" (login pelo SQLite).
IRIS_AUTH="supabase"

# --- Supabase — SOMENTE para scripts/setup_supabase.py (NÃO coloque no servidor) ---
# Credenciais de administrador: criam tabelas e ignoram a RLS. Use só na máquina de quem
# administra o banco, e remova depois.
# SUPABASE_DB_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# SUPABASE_ACCESS_TOKEN="sbp_..."
# Aceitas pelo app, mas desaconselhadas (ignoram a RLS):
# SUPABASE_SECRET_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# --- Inteligência artificial -------------------------------------------------
# [opcional] "1" = modo simulação (respostas locais, sem custo). Padrão: simulação se não
# houver nenhuma chave de provedor abaixo.
USE_MOCK_AI="0"
# Provedores (ao menos um em produção). Ordem da cadeia em IRIS_IA_PROVEDORES.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
# [opcional] Ordem de tentativa (anthropic,gemini,groq).
IRIS_IA_PROVEDORES="anthropic,gemini,groq"
# [opcional] Modelo Claude (claude-opus-5) e esforço: low | medium | high | xhigh | max (medium).
# IRIS_IA_MODELO="claude-opus-5"
IRIS_IA_ESFORCO="medium"
# [opcional] Limites: tokens da resposta (16000), timeout em s (120), retentativas (2).
IRIS_IA_MAX_TOKENS="16000"
IRIS_IA_TIMEOUT="120"
IRIS_IA_MAX_TENTATIVAS="2"
# [opcional] "1" (padrão) ativa o fallback de modelo no servidor da Anthropic.
IRIS_IA_FALLBACK_SERVIDOR="1"
# [opcional] Modelos dos provedores alternativos.
IRIS_GEMINI_MODELO="gemini-flash-latest"
IRIS_GROQ_MODELO="openai/gpt-oss-20b"
IRIS_GROQ_MODELO_VISAO="qwen/qwen3.6-27b"
# [opcional] Atraso artificial do modo simulação, em ms (500).
IRIS_SIMULACAO_LATENCIA_MS="500"

# --- Hospedagem (passenger_wsgi.py) ------------------------------------------
# [opcional] Python do virtualenv, só se o Passenger subir com o Python do sistema.
# IRIS_PYTHON="/home/u123456789/virtualenv/iris/3.12/bin/python"
# [opcional] "1" (padrão) confia no X-Forwarded-Proto do proxy HTTPS da Hostinger.
IRIS_PROXY_FIX="1"
# [opcional] DEBUG | INFO | WARNING | ERROR (INFO).
IRIS_LOG_NIVEL="INFO"
